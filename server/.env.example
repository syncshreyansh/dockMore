# DockMore Backend — Environment Variables (example)
# Copy to .env and fill in real values. Never commit .env.

# ── Database ────────────────────────────────────────────────────────────────
# Session-pooler URL from Supabase Dashboard → Connect → Session pooler
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-X-[REGION].pooler.supabase.com:5432/postgres

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Google OAuth ────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ── Token encryption (AES-256-GCM) ─────────────────────────────────────────
# Must be a 64-character hex string (32 raw bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your-64-char-hex-key-here

# ── Supabase Auth Admin ─────────────────────────────────────────────────────
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: enables AI-assisted code review and commit message generation.
GROQ_API_KEY=your-groq-api-key-here
